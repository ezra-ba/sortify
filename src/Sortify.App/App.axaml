<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sortify.App.App"
             xmlns:local="using:Sortify.App"
             RequestedThemeVariant="Light">
             <!-- Sortify uses a light palette so custom button hover colors remain readable. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ToggleSwitchBackgroundChecked" Color="#7657D9" />
                    <SolidColorBrush x:Key="ToggleSwitchBackgroundCheckedPointerOver" Color="#6545C5" />
                    <SolidColorBrush x:Key="ToggleSwitchBackgroundCheckedPressed" Color="#5536AE" />
                    <SolidColorBrush x:Key="ToggleSwitchOnBackground" Color="#7657D9" />
                    <SolidColorBrush x:Key="ToggleSwitchOnBackgroundPointerOver" Color="#6545C5" />
                    <SolidColorBrush x:Key="ToggleSwitchOnBackgroundPressed" Color="#5536AE" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ToggleSwitchBackgroundChecked" Color="#9B82F3" />
                    <SolidColorBrush x:Key="ToggleSwitchBackgroundCheckedPointerOver" Color="#B09DF8" />
                    <SolidColorBrush x:Key="ToggleSwitchBackgroundCheckedPressed" Color="#7657D9" />
                    <SolidColorBrush x:Key="ToggleSwitchOnBackground" Color="#9B82F3" />
                    <SolidColorBrush x:Key="ToggleSwitchOnBackgroundPointerOver" Color="#B09DF8" />
                    <SolidColorBrush x:Key="ToggleSwitchOnBackgroundPressed" Color="#7657D9" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Sortify.App/Themes/DesignSystem.axaml" />
    </Application.Styles>
</Application>
