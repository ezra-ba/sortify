<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sortify.App.App"
             xmlns:local="using:Sortify.App"
             RequestedThemeVariant="Light">
             <!-- Sortify uses a light palette so custom button hover colors remain readable. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
