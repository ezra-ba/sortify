<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Sortify.App.ViewModels" x:Class="Sortify.App.Views.DownloadStatisticsView" x:DataType="vm:DownloadStatisticsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.stat-card"><Setter Property="Background" Value="{DynamicResource BrushSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="44,34" Spacing="22">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5"><TextBlock Classes="heading" Text="Download-Statistik"/><TextBlock Classes="muted" Text="Eine Übersicht über deine Downloads und deren Quellen."/></StackPanel>
        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="muted" Text="ZEITRAUM" FontSize="11" FontWeight="SemiBold"/><ComboBox Width="150" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"/></StackPanel>
      </Grid>
      <ItemsControl ItemsSource="{Binding Kpis}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><Border Classes="stat-card" MinHeight="120" Margin="0,0,12,12" Padding="18"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="7" MinWidth="0"><TextBlock Classes="muted" Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2"/><TextBlock FontSize="25" FontWeight="SemiBold" Text="{Binding Value}" TextTrimming="CharacterEllipsis"/><TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Foreground="{DynamicResource BrushAccent}" Text="{Binding Icon}" FontSize="19" VerticalAlignment="Top" Margin="6,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="*,330" ColumnSpacing="18">
        <Border Classes="stat-card" Padding="22"><StackPanel Spacing="15"><TextBlock FontSize="18" FontWeight="SemiBold" Text="Downloads im Zeitverlauf"/><Grid Height="190" RowDefinitions="*,Auto"><Grid ColumnDefinitions="34,*"><StackPanel VerticalAlignment="Stretch" Spacing="25"><TextBlock Classes="muted" Text="100" FontSize="10"/><TextBlock Classes="muted" Text="50" FontSize="10"/><TextBlock Classes="muted" Text="0" FontSize="10"/></StackPanel><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Border Grid.Row="0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"/><Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"/><Border Grid.Row="2" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"/><Border Grid.Row="3" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"/><ItemsControl ItemsSource="{Binding Timeline}" VerticalAlignment="Bottom"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel VerticalAlignment="Bottom"><Border Background="{DynamicResource BrushAccent}" Height="{Binding ChartHeight}" Width="22" CornerRadius="4,4,0,0" HorizontalAlignment="Center"/><TextBlock Text="{Binding Label}" Classes="muted" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="10"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Grid></Grid></StackPanel></Border>
        <Border Grid.Column="1" Classes="stat-card" Padding="22"><StackPanel Spacing="15"><TextBlock FontSize="18" FontWeight="SemiBold" Text="Nach Quelle"/><Grid ColumnDefinitions="142,*" Height="150"><Grid Grid.Column="0" Width="128" Height="128" HorizontalAlignment="Left" VerticalAlignment="Center"><Ellipse Width="128" Height="128" Stroke="#7657D9" StrokeThickness="20"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1"><TextBlock Text="1.284" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Downloads" Classes="muted" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Grid><ItemsControl Grid.Column="1" ItemsSource="{Binding Sources}" VerticalAlignment="Center" Margin="10,0,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="12,*,Auto" Margin="0,5"><Border Background="{Binding Color}" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="7,0,10,0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding ShareText}" Classes="muted" FontSize="11" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></StackPanel></Border>
      </Grid>
      <Border Classes="stat-card" Padding="22"><StackPanel Spacing="14"><TextBlock FontSize="18" FontWeight="SemiBold" Text="Top-Quellen"/><ItemsControl ItemsSource="{Binding TopSources}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="34,170,*,Auto" ColumnSpacing="12" Margin="0,4"><Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource BrushSurfaceSubtle}"><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Border Grid.Column="2" Height="8" Background="{DynamicResource BrushSurfaceSubtle}" CornerRadius="4" VerticalAlignment="Center"><Border Background="{DynamicResource BrushAccent}" Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="4"/></Border><TextBlock Grid.Column="3" Text="{Binding Downloads}" Classes="muted" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
