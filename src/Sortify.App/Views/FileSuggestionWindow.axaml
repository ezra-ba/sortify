<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sortify.App.ViewModels"
        x:Class="Sortify.App.Views.FileSuggestionWindow"
        x:DataType="vm:FileSuggestionViewModel"
        Icon="/Assets/Branding/sortify-icon.png"
        Title="Neues Dokument · Sortify"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0">
    <Design.DataContext>
        <vm:FileSuggestionViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusInput}"/>
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}"/>
        </Style>
        <Style Selector="ComboBox /template/ Popup#PART_Popup Border">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceSubtle}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSelectedHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="ComboBoxItem:pressed">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style Selector="TextBox.motion:focus">
            <Setter Property="BorderBrush" Value="#7657D9"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox.motion:focus-visible">
            <Setter Property="BorderBrush" Value="#7657D9"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.validation-error">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox.motion.invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushError}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox.motion.invalid:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushError}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox.motion.invalid:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushError}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Styles>

    <Border Margin="0"
            Padding="16,16,16,4"
            Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusPopover}"
            ClipToBounds="True">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                <Border Width="28" Height="28" Background="#F0ECFF" CornerRadius="14">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#7657D9" Text="＋"/>
                </Border>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold" Text="Neue Datei"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="18" Text="›"/>
                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           Classes="muted"
                           Text="{Binding DetectedFileName}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding SourcePath}"/>
            </Grid>

            <StackPanel Spacing="8">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,*" ColumnSpacing="0" RowSpacing="5">
                    <TextBlock FontSize="12" Text="Zielordner"/>
                    <TextBlock Grid.Column="2" FontSize="12" Text="Dateiname"/>
                    <ComboBox Grid.Row="1" ItemsSource="{Binding TargetFolders}" SelectedItem="{Binding SelectedTargetFolder}" MinWidth="145" IsEnabled="{Binding CanEdit}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TargetFolderViewModel">
                                <TextBlock Text="{Binding Nickname}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="4,0" VerticalAlignment="Center" FontSize="18" Text="/"/>
                    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="0" RowSpacing="3">
                        <TextBox Classes="motion" x:Name="FileNameTextBox" FocusAdorner="{x:Null}" CornerRadius="{DynamicResource RadiusInput}" BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}" Text="{Binding NewFileName, Mode=TwoWay}" MaxLength="255" PlaceholderText="Dateiname" TextChanged="FileNameTextBox_TextChanged" GotFocus="FileNameTextBox_GotFocus" LostFocus="FileNameTextBox_LostFocus"
                                 ToolTip.IsOpen="{Binding HasValidationError}" IsEnabled="{Binding CanEdit}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Padding="0,0,10,0" Foreground="#6E6E73" Text="{Binding FileExtension}"/>
                    </Grid>
                </Grid>
                <TextBlock x:Name="FilePathPreviewTextBlock"
                           Classes="muted"
                           Text="{Binding FilePathPreview}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding FilePathPreview}"
                           ToolTip.ToolTipOpening="FilePathPreviewTextBlock_ToolTipOpening"/>
            </StackPanel>
            <TextBlock Text="{Binding SuggestionExplanation}"
                       TextWrapping="Wrap" Classes="muted"/>

            <TextBlock Text="{Binding OperationMessage}"
           TextWrapping="Wrap"
           FontSize="12"/>

            <Button Content="Datei erneut prüfen"
                    Classes="secondary motion"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding CanRefreshSource}"
                    Click="RefreshSourceButton_Click"/>

            <Border Height="1" Margin="-16,0,-16,-14"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
            <Button Classes="secondary motion"
                Content="Abbrechen"
                HorizontalAlignment="Left"
                IsEnabled="{Binding CanCancel}"
                Click="CancelButton_Click"/>

            <Button Grid.Column="1"
                Classes="primary motion"
                Content="Datei einsortieren"
                IsEnabled="{Binding CanConfirmMove}"
                Click="ConfirmButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
