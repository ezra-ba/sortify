<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sortify.App.ViewModels"
        x:Class="Sortify.App.Views.FileSuggestionWindow"
        x:DataType="vm:FileSuggestionViewModel"
        Icon="/Assets/Branding/sortify-icon.png"
        Title="Neues Dokument · Sortify"
        Width="440"
        SizeToContent="Height"
        MinWidth="400"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
    <Design.DataContext>
        <vm:FileSuggestionViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#756F66"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#6D665B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#5A534A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4D4942"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#D8D1C7"/>
            <Setter Property="Foreground" Value="#25231F"/>
        </Style>
        <Style Selector="TextBlock.validation-error">
            <Setter Property="Foreground" Value="#B42318"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Styles>

    <Border Margin="0"
            Padding="20"
            Background="#FFFFFF"
            BorderBrush="#D8D1C7"
            BorderThickness="1"
            CornerRadius="16">
        <StackPanel Spacing="16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="42" Height="42" Background="#EEE9E1" CornerRadius="21">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Text="＋" Foreground="#6D665B"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="#25231F" Text="Neues Dokument!"/>
                    <TextBlock Classes="muted" Text="{Binding DetectedFileName}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="8">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#867E73" Text="ZIEL UND DATEINAME"/>
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding TargetFolders}" SelectedItem="{Binding SelectedTargetFolder}" MinWidth="145">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TargetFolderViewModel">
                                <TextBlock Text="{Binding Nickname}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="18" Foreground="#A7A096" Text="/"/>
                    <Grid Grid.Column="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="0" RowSpacing="3">
                        <TextBox x:Name="FileNameTextBox" Text="{Binding NewFileName, Mode=TwoWay}" MaxLength="255" Watermark="Dateiname" TextChanged="FileNameTextBox_TextChanged"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Padding="0,0,10,0" Foreground="#756F66" Text="{Binding FileExtension}"/>
                        <TextBlock x:Name="ValidationHint"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Classes="validation-error"
                                   Text="Fehlerhafte Eingabe ⓘ"
                                   IsVisible="{Binding HasValidationError}"
                                   ToolTip.Tip="Erlaubt sind maximal 255 Unicode-Buchstaben, Zahlen, Leerzeichen sowie _ und -. Führende oder abschließende Leerzeichen und Sonderzeichen sind nicht erlaubt."
                                   Cursor="Hand"/>
                    </Grid>
                </Grid>
                <TextBlock Classes="muted" Text="{Binding FilePathPreview}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Classes="muted" Text="Der Dateiname kann vor dem Verschieben angepasst werden."/>
            </StackPanel>

            <Border Height="1" Background="#ECE7DF" Margin="-20,0"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Button Classes="secondary" Content="Abbrechen" HorizontalAlignment="Left" Click="CancelButton_Click"/>
                <Button Grid.Column="1" Classes="primary" Content="Datei einsortieren" IsEnabled="{Binding IsFileNameValid}"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
