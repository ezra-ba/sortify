<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Sortify.App.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:platform="using:Avalonia.Controls" mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760" x:Class="Sortify.App.Views.MainWindow" x:DataType="vm:MainViewModel" Icon="/Assets/Branding/sortify-icon.png" Title="Sortify · Ordnerverwaltung" Width="1180" Height="760" MinWidth="900" MinHeight="620" Background="#F5F5F7" SystemDecorations="None" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="44">
	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>
	<Window.Styles>
		<Style Selector="Button.window-button">
			<Setter Property="Width" Value="42"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#6E6E73"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontSize" Value="18"/>
		</Style>
		<Style Selector="Button.window-button:pointerover">
			<Setter Property="Background" Value="#F0ECFF"/>
			<Setter Property="Foreground" Value="#694FC5"/>
		</Style>
		<Style Selector="Button.window-button:pressed">
			<Setter Property="Background" Value="#EEE8FF"/>
			<Setter Property="Foreground" Value="#5438AE"/>
		</Style>
		<Style Selector="Button.window-button.close:pointerover">
			<Setter Property="Background" Value="#F7F3FF"/>
			<Setter Property="Foreground" Value="#1C1C1E"/>
		</Style>
		<Style Selector="Button.window-button.close:pressed">
			<Setter Property="Background" Value="#EEE8FF"/>
			<Setter Property="Foreground" Value="#1C1C1E"/>
		</Style>
		<Style Selector="TextBlock.heading">
			<Setter Property="Foreground" Value="#1C1C1E"/>
			<Setter Property="FontSize" Value="26"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="TextBlock.eyebrow">
			<Setter Property="Foreground" Value="#6E6E73"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="TextBlock.muted">
			<Setter Property="Foreground" Value="#6E6E73"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
		<Style Selector="Button.primary">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="Foreground" Value="#1C1C1E"/>
			<Setter Property="Padding" Value="16,10"/>
			<Setter Property="CornerRadius" Value="5"/>
		</Style>
		<Style Selector="Button.primary:pointerover">
			<Setter Property="Background" Value="#F7F3FF"/>
			<Setter Property="Foreground" Value="#1C1C1E"/>
		</Style>
		<Style Selector="Button.primary:pressed">
			<Setter Property="Background" Value="#EEE8FF"/>
			<Setter Property="Foreground" Value="#1C1C1E"/>
		</Style>
		<Style Selector="Button.secondary">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="Foreground" Value="#344054"/>
			<Setter Property="BorderBrush" Value="#D0D5DD"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="14,9"/>
			<Setter Property="CornerRadius" Value="5"/>
		</Style>
		<Style Selector="Button.secondary:pointerover">
			<Setter Property="Background" Value="#F7F3FF"/>
			<Setter Property="Foreground" Value="#6547C5"/>
			<Setter Property="BorderBrush" Value="#C5B8F5"/>
		</Style>
		<Style Selector="Button.secondary:pressed">
			<Setter Property="Background" Value="#EEE8FF"/>
			<Setter Property="Foreground" Value="#5438AE"/>
			<Setter Property="BorderBrush" Value="#A58FEB"/>
		</Style>
		<Style Selector="Button.target-folder.selected">
			<Setter Property="Background" Value="#F4F0FF"/>
			<Setter Property="BorderBrush" Value="#A58FEB"/>
		</Style>
		<Style Selector="Button.target-folder">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#E1E1E6"/>
			<Setter Property="RenderTransformOrigin" Value="50%,50%"/>
			<Setter Property="RenderTransform">
				<Setter.Value>
					<ScaleTransform ScaleX="1" ScaleY="1"/>
				</Setter.Value>
			</Setter>
		</Style>
		<Style Selector="Button.target-folder:pointerover">
			<Setter Property="Background" Value="#FBFAFF"/>
			<Setter Property="BorderBrush" Value="#CFC5F7"/>
		</Style>
		<Style Selector="Button.target-folder.press-feedback">
			<Setter Property="Background" Value="#EAE3FF"/>
			<Setter Property="BorderBrush" Value="#B9AAEE"/>
			<Setter Property="RenderTransform">
				<Setter.Value>
					<ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
				</Setter.Value>
			</Setter>
			<Setter Property="Opacity" Value="0.88"/>
		</Style>
		<Style Selector="Button.target-folder.selected">
			<Setter Property="Background" Value="#F4F0FF"/>
			<Setter Property="BorderBrush" Value="#A58FEB"/>
		</Style>
		<Style Selector="Button.target-folder.selected.press-feedback">
			<Setter Property="Background" Value="#EAE3FF"/>
			<Setter Property="BorderBrush" Value="#B9AAEE"/>
		</Style>
		<Style Selector="Border.target-folder-card.editing">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#E1E1E6"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
		<Style Selector="Border.target-folder-card.dragging">
			<Setter Property="Opacity" Value="0"/>
		</Style>
	</Window.Styles>
	<Grid Background="{DynamicResource Brush.Canvas}" RowDefinitions="44,*">
	<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding !IsSavingSettings}">
		<StackPanel Margin="44,34" Spacing="26">
			<Border Padding="24" Background="#FFFFFF" BorderBrush="#E1E1E6" BorderThickness="1" CornerRadius="8">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="22">
					<Border Width="42" Height="42" Background="#F0ECFF" CornerRadius="21">
						<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Text="◉" Foreground="#7657D9"/>
					</Border>
					<StackPanel Grid.Column="1" Spacing="5">
						<TextBlock Classes="eyebrow" Text="ÜBERWACHUNGS-ORDNER"/>
						<TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1C1C1E" Text="{Binding WatchedFolder}"/>
						<TextBlock Classes="muted" Text="{Binding SettingsStatus}" TextWrapping="Wrap"/>
					</StackPanel>
					<Button Grid.Column="2" Classes="secondary motion" Content="Ordner wechseln" Click="SelectWatchedFolder"/>
				</Grid>
			</Border>
			<Grid ColumnDefinitions="*,300" ColumnSpacing="22">
				<Border Padding="24" Background="#FFFFFF" BorderBrush="#E1E1E6" BorderThickness="1" CornerRadius="8">
					<StackPanel Spacing="18">
						<Grid ColumnDefinitions="*,Auto">
							<StackPanel Spacing="4">
								<TextBlock FontSize="19" FontWeight="SemiBold" Foreground="#1C1C1E" Text="Target-Ordner"/>
								<TextBlock Classes="muted" Text="Ziele für die automatische Dateisortierung"/>
							</StackPanel>
							<TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#8B72E6" Text="{Binding TargetFolders.Count, StringFormat='{}{0} Ziele'}"/>
						</Grid>
						<ItemsControl ItemsSource="{Binding TargetFolders}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Classes="target-folder-card" Classes.editing="{Binding IsEditingNickname}" Classes.dragging="{Binding IsDragging}" Padding="0" Margin="0,0,0,8" Background="Transparent" BorderThickness="0" CornerRadius="6">
										<Border.Transitions>
											<Transitions>
								<DoubleTransition Property="Opacity" Duration="0:0:0.06" />
												<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
											</Transitions>
										</Border.Transitions>
										<Grid>
						<Button Classes="target-folder motion" Classes.selected="{Binding IsSelected}" IsVisible="{Binding !IsEditingNickname}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" BorderThickness="1" CornerRadius="6" Command="{Binding $parent[Window].DataContext.SelectTargetFolderCommand}" CommandParameter="{Binding}">
											<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
														<Border Width="34" Height="34" Background="#F0ECFF" CornerRadius="17"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="•" Foreground="#7657D9" FontWeight="SemiBold"/></Border>
												<StackPanel Grid.Column="1" Spacing="4">
																								<TextBlock FontWeight="SemiBold" Foreground="#1C1C1E" Text="{Binding Nickname}"/>
													<TextBlock Classes="muted" Text="{Binding Path}"/>
												</StackPanel>
														<TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#7657D9" Text="STANDARD" IsVisible="{Binding IsDefault}" FontSize="10" FontWeight="SemiBold"/>
											</Grid>
										</Button>
						<Border IsVisible="{Binding IsEditingNickname}" Background="#FFFFFF" BorderBrush="#E1E1E6" BorderThickness="1" CornerRadius="6" Padding="16">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
							<Border Width="34" Height="34" Background="#F0ECFF" CornerRadius="17">
								<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="•" Foreground="#7657D9" FontWeight="SemiBold"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="4">
								<StackPanel Orientation="Horizontal" Spacing="4">
									<TextBox Width="150" Text="{Binding DraftNickname, Mode=TwoWay}"/>
									<Button Content="OK" Command="{Binding $parent[Window].DataContext.SaveTargetNicknameCommand}" CommandParameter="{Binding}"/>
									<Button Content="Abbrechen" Command="{Binding CancelRenameCommand}"/>
								</StackPanel>
								<TextBlock Classes="muted" Text="{Binding Path}"/>
							</StackPanel>
							<TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#7657D9" Text="STANDARD" IsVisible="{Binding IsDefault}" FontSize="10" FontWeight="SemiBold"/>
						</Grid>
						</Border>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>
				<Border Grid.Column="1" Padding="22" Background="#FFFFFF" BorderBrush="#E1E1E6" BorderThickness="1" CornerRadius="8">
					<StackPanel Spacing="14">
						<TextBlock FontSize="19" FontWeight="SemiBold" Foreground="#1C1C1E" Text="Verwaltung"/>
						<Border Margin="0,4,0,2" Height="1" Background="#E6E6EB"/>
						<Button Classes="primary motion" HorizontalContentAlignment="Center" Content="Popup-Vorschau öffnen" Click="OpenFileSuggestion"/>
								<Button Classes="primary motion" HorizontalContentAlignment="Center" Content="＋  Target-Ordner hinzufügen" Click="AddTargetFolder"/>
								<Button Classes="secondary motion" HorizontalContentAlignment="Center" Content="Als Standard festlegen" Command="{Binding SetDefaultTargetFolderCommand}"/>
								<Button Classes="secondary motion" HorizontalContentAlignment="Center" Content="Spitznamen ändern" Command="{Binding BeginRenameTargetFolderCommand}"/>
								<Button Classes="secondary motion" HorizontalContentAlignment="Center" Content="Target-Ordner entfernen" Command="{Binding RemoveTargetFolderCommand}"/>
					</StackPanel>
				</Border>
			</Grid>
		</StackPanel>
	</ScrollViewer>
		<Canvas Grid.Row="1" IsHitTestVisible="False">
			<Border x:Name="DragPreview" Width="420" Padding="16" Background="#FFFFFF" BorderBrush="#B9AAEE" BorderThickness="1" CornerRadius="6" Opacity="0.92" IsVisible="False">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
					<Border Width="34" Height="34" Background="#F0ECFF" CornerRadius="17">
						<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="•" Foreground="#7657D9" FontWeight="SemiBold"/>
					</Border>
					<StackPanel Grid.Column="1" Spacing="4">
						<TextBlock x:Name="DragPreviewNickname" FontWeight="SemiBold" Foreground="#1C1C1E"/>
						<TextBlock x:Name="DragPreviewPath" Classes="muted"/>
					</StackPanel>
					<TextBlock x:Name="DragPreviewDefault" Grid.Column="2" VerticalAlignment="Center" Foreground="#7657D9" Text="STANDARD" IsVisible="False" FontSize="10" FontWeight="SemiBold"/>
				</Grid>
			</Border>
		</Canvas>
		<Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E1E1E6" BorderThickness="0,0,0,1" Padding="14,0,8,0" platform:Win32Properties.NonClientHitTestResult="Caption">
			<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
				<StackPanel x:Name="TitleBarBrand" IsHitTestVisible="False" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
					<Image Width="24" Height="24" Stretch="Uniform" Source="/Assets/Branding/sortify-icon.png"/>
					<TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="#1C1C1E" Text="Sortify"/>
				</StackPanel>
				<Border Grid.Column="1" Background="Transparent" PointerPressed="TitleBar_PointerPressed"/>
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
					<Button platform:Win32Properties.NonClientHitTestResult="Client" Classes="window-button" Tag="minimize" Click="WindowButton_Click">
						<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE949;"/>
					</Button>
					<Button platform:Win32Properties.NonClientHitTestResult="Client" Classes="window-button" Tag="maximize" Click="WindowButton_Click">
						<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE922;"/>
					</Button>
					<Button platform:Win32Properties.NonClientHitTestResult="Client" Classes="window-button close" Tag="close" Click="WindowButton_Click" PointerEntered="CloseButton_PointerEntered" PointerExited="CloseButton_PointerExited" PointerPressed="CloseButton_PointerPressed" PointerReleased="CloseButton_PointerReleased">
						<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE8BB;"/>
					</Button>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Window>
