<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Sortify.App.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760" x:Class="Sortify.App.Views.MainWindow" x:DataType="vm:MainViewModel" Icon="/Assets/Branding/sortify-icon.png" Title="Sortify · Ordnerverwaltung" Width="1180" Height="760" MinWidth="900" MinHeight="620" Background="#F4F1EC">
	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>
	<Window.Styles>
		<Style Selector="TextBlock.heading">
			<Setter Property="Foreground" Value="#25231F"/>
			<Setter Property="FontSize" Value="26"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="TextBlock.eyebrow">
			<Setter Property="Foreground" Value="#867E73"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="TextBlock.muted">
			<Setter Property="Foreground" Value="#756F66"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>
		<Style Selector="Button.primary">
			<Setter Property="Background" Value="#6D665B"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Padding" Value="16,10"/>
			<Setter Property="CornerRadius" Value="5"/>
		</Style>
		<Style Selector="Button.primary:pointerover">
			<Setter Property="Background" Value="#5A534A"/>
			<Setter Property="Foreground" Value="#FFFFFF"/>
		</Style>
		<Style Selector="Button.primary:pressed">
			<Setter Property="Background" Value="#786F63"/>
			<Setter Property="Foreground" Value="#FFFFFF"/>
		</Style>
		<Style Selector="Button.secondary">
			<Setter Property="Background" Value="#F4F1EC"/>
			<Setter Property="Foreground" Value="#4D4942"/>
			<Setter Property="BorderBrush" Value="#D8D1C7"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="14,9"/>
			<Setter Property="CornerRadius" Value="5"/>
		</Style>
		<Style Selector="Button.secondary:pointerover">
			<Setter Property="Background" Value="#E8E2D8"/>
			<Setter Property="Foreground" Value="#302D28"/>
			<Setter Property="BorderBrush" Value="#BDB4A7"/>
		</Style>
		<Style Selector="Button.secondary:pressed">
			<Setter Property="Background" Value="#E5DED4"/>
			<Setter Property="Foreground" Value="#25231F"/>
			<Setter Property="BorderBrush" Value="#AFA597"/>
		</Style>
		<Style Selector="Button.target-folder.selected">
			<Setter Property="Background" Value="#EDEAE5"/>
			<Setter Property="BorderBrush" Value="#BDB5AA"/>
		</Style>
		<Style Selector="Button.target-folder">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#E8E3DB"/>
		</Style>
		<Style Selector="Border.target-folder-card.editing">
			<Setter Property="Background" Value="#FFFFFF"/>
			<Setter Property="BorderBrush" Value="#E8E3DB"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
	</Window.Styles>
	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="44,34" Spacing="26">
			<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
				<Image Width="48" Height="48" Stretch="Uniform" Source="/Assets/Branding/sortify-icon.png"/>
				<TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="32" FontWeight="SemiBold" Foreground="#25231F" Text="Sortify"/>
				<Button Grid.Column="2" Classes="primary" Content="Popup-Vorschau öffnen" Click="OpenFileSuggestion"/>
			</Grid>
			<Border Padding="24" Background="#FFFFFF" BorderBrush="#DED8CE" BorderThickness="1" CornerRadius="8">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="22">
					<Border Width="42" Height="42" Background="#EEE9E1" CornerRadius="21">
						<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Text="◉" Foreground="#6D665B"/>
					</Border>
					<StackPanel Grid.Column="1" Spacing="5">
						<TextBlock Classes="eyebrow" Text="ÜBERWACHUNGS-ORDNER"/>
						<TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#25231F" Text="{Binding WatchedFolder}"/>
						<TextBlock Classes="muted" Text="{Binding SettingsStatus}" TextWrapping="Wrap"/>
					</StackPanel>
					<Button Grid.Column="2" Classes="secondary" Content="Ordner wechseln" Click="SelectWatchedFolder"/>
				</Grid>
			</Border>
			<Grid ColumnDefinitions="*,300" ColumnSpacing="22">
				<Border Padding="24" Background="#FFFFFF" BorderBrush="#DED8CE" BorderThickness="1" CornerRadius="8">
					<StackPanel Spacing="18">
						<Grid ColumnDefinitions="*,Auto">
							<StackPanel Spacing="4">
								<TextBlock FontSize="19" FontWeight="SemiBold" Foreground="#25231F" Text="Target-Ordner"/>
								<TextBlock Classes="muted" Text="Ziele für die automatische Dateisortierung"/>
							</StackPanel>
							<Border Grid.Column="1" Padding="10,5" Background="#EEE9E1" CornerRadius="12">
								<TextBlock FontSize="12" Foreground="#6D665B" Text="{Binding TargetFolders.Count, StringFormat='{}{0} Ziele'}"/>
							</Border>
						</Grid>
						<ItemsControl ItemsSource="{Binding TargetFolders}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Classes="target-folder-card" Classes.editing="{Binding IsEditingNickname}" Padding="0" Margin="0,0,0,8" Background="Transparent" BorderThickness="0" CornerRadius="6">
										<Grid>
						<Button Classes="target-folder" Classes.selected="{Binding IsSelected}" IsVisible="{Binding !IsEditingNickname}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" BorderThickness="1" CornerRadius="6" Command="{Binding $parent[Window].DataContext.SelectTargetFolderCommand}" CommandParameter="{Binding}">
											<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
												<Border Width="34" Height="34" Background="#E9E2D7" CornerRadius="17"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="•" Foreground="#6D665B" FontWeight="SemiBold"/></Border>
												<StackPanel Grid.Column="1" Spacing="4">
																		<TextBlock FontWeight="SemiBold" Foreground="#302D28" Text="{Binding Nickname}"/>
													<TextBlock Classes="muted" Text="{Binding Path}"/>
												</StackPanel>
												<TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#B0925D" Text="STANDARD" IsVisible="{Binding IsDefault}" FontSize="10" FontWeight="SemiBold"/>
											</Grid>
										</Button>
						<Border IsVisible="{Binding IsEditingNickname}" Background="#FFFFFF" BorderBrush="#E8E3DB" BorderThickness="1" CornerRadius="6" Padding="16">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
							<Border Width="34" Height="34" Background="#E9E2D7" CornerRadius="17">
								<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="•" Foreground="#6D665B" FontWeight="SemiBold"/>
							</Border>
							<StackPanel Grid.Column="1" Spacing="4">
								<StackPanel Orientation="Horizontal" Spacing="4">
									<TextBox Width="150" Text="{Binding Nickname, Mode=TwoWay}"/>
									<Button Content="OK" Command="{Binding SaveNicknameCommand}"/>
									<Button Content="Abbrechen" Command="{Binding CancelRenameCommand}"/>
								</StackPanel>
								<TextBlock Classes="muted" Text="{Binding Path}"/>
							</StackPanel>
							<TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#B0925D" Text="STANDARD" IsVisible="{Binding IsDefault}" FontSize="10" FontWeight="SemiBold"/>
						</Grid>
						</Border>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>
				<Border Grid.Column="1" Padding="22" Background="#FFFFFF" BorderBrush="#DED8CE" BorderThickness="1" CornerRadius="8">
					<StackPanel Spacing="14">
						<TextBlock FontSize="19" FontWeight="SemiBold" Foreground="#25231F" Text="Verwaltung"/>
						<TextBlock Classes="muted" TextWrapping="Wrap" Text="Wähle einen Target-Ordner aus, um ihn zu bearbeiten."/>
						<Border Margin="0,4,0,2" Height="1" Background="#ECE7DF"/>
						<Button Classes="primary" HorizontalContentAlignment="Center" Content="＋  Target-Ordner hinzufügen" Click="AddTargetFolder"/>
						<Button Classes="secondary" HorizontalContentAlignment="Center" Content="Als Standard festlegen" Command="{Binding SetDefaultTargetFolderCommand}"/>
						<Button Classes="secondary" HorizontalContentAlignment="Center" Content="Spitznamen ändern" Command="{Binding BeginRenameTargetFolderCommand}"/>
						<Button Classes="secondary" HorizontalContentAlignment="Center" Content="Target-Ordner entfernen" Command="{Binding RemoveTargetFolderCommand}"/>
						<TextBlock Margin="0,12,0,0" Classes="muted" TextWrapping="Wrap" Text="Tipp: Der Spitzname wird in der Liste angezeigt und kann jederzeit angepasst werden."/>
					</StackPanel>
				</Border>
			</Grid>
		</StackPanel>
	</ScrollViewer>
</Window>
