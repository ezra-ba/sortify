<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Sortify.App.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:platform="using:Avalonia.Controls" mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760" x:Class="Sortify.App.Views.MainWindow" x:DataType="vm:MainViewModel" Icon="/Assets/Branding/sortify-icon.png" Title="" Width="1180" Height="760" MinWidth="900" MinHeight="620" Background="{DynamicResource BrushCanvas}" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="40">
	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>
	<Window.Styles>
		<Style Selector="Button.window-button">
			<Setter Property="Width" Value="42"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontSize" Value="18"/>
		</Style>
		<Style Selector="TextBlock.heading">
			<Setter Property="FontSize" Value="26"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="TextBlock.eyebrow">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="TextBlock.muted">
			<Setter Property="FontSize" Value="13"/>
		</Style>
		<Style Selector="Button.primary">
			<Setter Property="Padding" Value="16,10"/>
			<Setter Property="CornerRadius" Value="5"/>
		</Style>
		<Style Selector="Button.secondary">
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="14,9"/>
			<Setter Property="CornerRadius" Value="5"/>
		</Style>
		<Style Selector="Button.settings-button">
			<Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
			<Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="CornerRadius" Value="18"/>
		</Style>
		<Style Selector="Button.target-folder.selected">
			<Setter Property="Background" Value="{DynamicResource BrushSurfaceSubtle}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
		</Style>
		<Style Selector="Button.target-folder">
			<Setter Property="Background" Value="{DynamicResource BrushControlSurface}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
			<Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
			<Setter Property="RenderTransformOrigin" Value="50%,50%"/>
			<Setter Property="RenderTransform">
				<Setter.Value>
					<ScaleTransform ScaleX="1" ScaleY="1"/>
				</Setter.Value>
			</Setter>
		</Style>
		<Style Selector="Button.target-folder.selected">
			<Setter Property="Background" Value="{DynamicResource BrushSurfaceSubtle}"/>
		</Style>
		<Style Selector="Button.target-folder:pointerover:not(:disabled)">
			<Setter Property="Background" Value="{DynamicResource BrushSelectedHover}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
		</Style>
		<Style Selector="Button.target-folder.selected:pointerover:not(:disabled)">
			<Setter Property="Background" Value="{DynamicResource BrushSelectedHover}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BrushAccentHover}"/>
		</Style>
		<Style Selector="Button.target-folder:pressed:not(:disabled)">
			<Setter Property="Background" Value="{DynamicResource BrushSelectedHover}"/>
		</Style>
		<Style Selector="Button.target-folder.press-feedback">
			<Setter Property="Background" Value="{DynamicResource BrushSelectedHover}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
			<Setter Property="Opacity" Value="0.9"/>
		</Style>
		<Style Selector="Border.surface-card">
			<Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
		</Style>
		<Style Selector="Border.target-folder-card.editing">
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
		<Style Selector="Border.target-folder-card.dragging">
			<Setter Property="Opacity" Value="0.45"/>
		</Style>

        <Style Selector="Border.target-folder-card">
            <Setter Property="Background" Value="{DynamicResource BrushControlSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
        </Style>
        <Style Selector="Border.target-folder-card.selected">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceSubtle}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
        </Style>
        <Style Selector="Button.target-folder, Button.target-folder.selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.rule-tag, Button.rule-tag:pointerover, Button.rule-tag:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushRuleTagNormalBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushRuleTagNormalForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushRuleTagNormalBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="220"/>
        </Style>
        <Style Selector="Button.rule-tag.missing, Button.rule-tag.missing:pointerover, Button.rule-tag.missing:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushRuleTagNormalBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushRuleTagNormalForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushRuleTagNormalBorder}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MaxWidth" Value="36"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="Button.rule-tag.duplicate, Button.rule-tag.duplicate:pointerover, Button.rule-tag.duplicate:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushRuleTagWarningBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushRuleTagWarningForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushRuleTagWarningBorder}"/>
        </Style>
        <Style Selector="Button.rule-tag.inactive, Button.rule-tag.inactive:pointerover, Button.rule-tag.inactive:pressed">
            <Setter Property="Background" Value="{DynamicResource BrushRuleTagDisabledBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushRuleTagDisabledForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushRuleTagDisabledBorder}"/>
        </Style>
        <Style Selector="Button.rule-tag:pointerover"><Setter Property="Opacity" Value="0.85"/></Style>
        <Style Selector="Button.rule-tag:pressed"><Setter Property="Opacity" Value="0.7"/></Style>
	</Window.Styles>
	<Border Background="{DynamicResource BrushCanvas}" BorderThickness="0,1,0,0">
	<Grid RowDefinitions="40,*">
		<Border Grid.Row="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,0,170,0" platform:Win32Properties.NonClientHitTestResult="Caption">
			<Grid ColumnDefinitions="Auto,*">
				<StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
					<Image Width="24" Height="24" Stretch="Uniform" Source="/Assets/Branding/sortify-icon.png" IsHitTestVisible="False"/>
					<TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="Sortify" IsHitTestVisible="False"/>
					<Button Classes="settings-button motion" Width="30" Height="30" Margin="8,0,0,0" Click="OpenSettings" IsTabStop="False" platform:Win32Properties.NonClientHitTestResult="Client">
						<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE713;"/>
					</Button>
				</StackPanel>
				<Border Grid.Column="1"/>
			</Grid>
		</Border>
		<Grid Grid.Row="1">
	<ScrollViewer HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding !IsSavingSettings}">
		<StackPanel Margin="44,34" Spacing="26">
			<Border Classes="surface-card" Padding="24" BorderThickness="1" CornerRadius="12">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="22">
					<Border Width="42" Height="42" CornerRadius="21">
						<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Text="◉"/>
					</Border>
					<StackPanel Grid.Column="1" Spacing="5">
						<TextBlock Classes="eyebrow" Text="ÜBERWACHUNGS-ORDNER"/>
						<TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding WatchedFolder}"/>
						<TextBlock Classes="muted" Text="{Binding SettingsStatus}" TextWrapping="Wrap"/>
						<TextBlock Text="{Binding RuleTargetWarnings}" IsVisible="{Binding HasRuleTargetWarnings}" TextWrapping="Wrap" Foreground="#9A3412"/>
						<TextBlock Classes="muted" Text="{Binding MonitoringStatus}" TextWrapping="Wrap"/>
					</StackPanel>
					<Button Grid.Column="2" Classes="secondary motion" Content="Ordner wechseln" Click="SelectWatchedFolder"/>
				</Grid>
			</Border>
			<Grid ColumnDefinitions="*,300" ColumnSpacing="22">
				<Border Classes="surface-card" Padding="24" BorderThickness="1" CornerRadius="12">
					<StackPanel Spacing="18">
						<Grid ColumnDefinitions="*,Auto">
							<StackPanel Spacing="4">
								<TextBlock FontSize="19" FontWeight="SemiBold" Text="Target-Ordner"/>
								<TextBlock Classes="muted" Text="Ziele für die automatische Dateisortierung"/>
							</StackPanel>
							<TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Text="{Binding TargetFolders.Count, StringFormat='{}{0} Ziele'}"/>
						</Grid>
                        <ItemsControl ItemsSource="{Binding TargetFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TargetFolderViewModel">
                                    <Border Classes="target-folder-card" Classes.selected="{Binding IsSelected}"
                                            Classes.editing="{Binding IsEditingNickname}" Classes.dragging="{Binding IsDragging}"
                                            Margin="0,0,0,8" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                        <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.06"/></Transitions></Border.Transitions>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Button Grid.Column="0" Classes="target-folder motion" Classes.selected="{Binding IsSelected}"
                                                    IsVisible="{Binding !IsEditingNickname}" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch" Padding="16" BorderThickness="0" CornerRadius="6"
                                                    MinHeight="72" Command="{Binding $parent[Window].DataContext.SelectTargetFolderCommand}" CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                    <Border Width="34" Height="34" CornerRadius="17"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="•" FontWeight="SemiBold"/></Border>
                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Nickname}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Nickname}"/>
                                                        <TextBlock Classes="muted" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <Border Grid.Column="0" IsVisible="{Binding IsEditingNickname}" Padding="16">
                                                <StackPanel Spacing="4">
                                                    <WrapPanel>
                                                        <TextBox Width="150" Text="{Binding DraftNickname, Mode=TwoWay}"/>
                                                        <Button Classes="nickname-action" Content="OK" Command="{Binding $parent[Window].DataContext.SaveTargetNicknameCommand}" CommandParameter="{Binding}"/>
                                                        <Button Classes="nickname-action" Content="Abbrechen" Command="{Binding CancelRenameCommand}"/>
                                                    </WrapPanel>
                                                    <TextBlock Classes="muted" Text="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Grid.Column="1" MaxWidth="240" Margin="8,12,14,12" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock HorizontalAlignment="Right" Text="STANDARD" IsVisible="{Binding IsDefault}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"/>
                                                <ItemsControl ItemsSource="{Binding RuleTags}" HorizontalAlignment="Right">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:TargetRuleTagViewModel">
                                                            <Button Classes="rule-tag" Classes.missing="{Binding IsMissing}" Classes.duplicate="{Binding IsDuplicate}"
                                                                    Classes.inactive="{Binding IsDisabled}" Margin="4,2,0,2" Click="OpenRuleTag"
                                                                    ToolTip.Tip="{Binding ToolTip}" AutomationProperties.Name="{Binding AccessibleName}">
                                                                <Grid>
                                                                    <Path IsVisible="{Binding IsMissing}" Data="M 12,2 L 12,22 M 2,12 L 22,12" Width="14" Height="14" Stretch="Uniform"
                                                                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.75" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="0" IsVisible="{Binding !IsMissing}">
                                                                        <TextBlock Text="!" Margin="0,0,5,0" Foreground="{Binding $parent[Button].Foreground}" FontWeight="Bold" IsVisible="{Binding IsDuplicate}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Foreground="{Binding $parent[Button].Foreground}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="Gleiche Bedingungen in mehreren Zielen" IsVisible="{Binding HasDuplicateRules}"
                                                           Foreground="{DynamicResource BrushRuleTagWarningForeground}" FontSize="11" TextWrapping="Wrap" MaxWidth="230" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
					</StackPanel>
				</Border>
				<Border Classes="surface-card" Grid.Column="1" Padding="22" BorderThickness="1" CornerRadius="12">
					<StackPanel Spacing="14">
						<TextBlock FontSize="19" FontWeight="SemiBold" Text="Verwaltung"/>
						<Border Margin="0,4,0,2" Height="1"/>
						<Button Classes="secondary motion" HorizontalContentAlignment="Center" Content="Regel für Target-Ordner anlegen" IsEnabled="{Binding HasSelectedTargetFolder}" Click="OpenTargetRules"/>
						<Button Classes="primary motion" HorizontalContentAlignment="Center" Content="Popup-Vorschau öffnen" Click="OpenFileSuggestion"/>
								<Button Classes="primary motion" HorizontalContentAlignment="Center" Content="＋  Target-Ordner hinzufügen" Click="AddTargetFolder"/>
								<Button Classes="secondary motion" HorizontalContentAlignment="Center" Content="Als Standard festlegen" Command="{Binding SetDefaultTargetFolderCommand}"/>
								<Button Classes="secondary motion" HorizontalContentAlignment="Center" Content="Spitznamen ändern" Command="{Binding BeginRenameTargetFolderCommand}"/>
								<Button Classes="secondary motion" HorizontalContentAlignment="Center" Content="Target-Ordner entfernen" Command="{Binding RemoveTargetFolderCommand}"/>
					</StackPanel>
				</Border>
			</Grid>
		</StackPanel>
	</ScrollViewer>
		<Canvas IsHitTestVisible="False">
			<Border x:Name="DragPreview" Width="420" Padding="16" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="6" Opacity="0.96" IsVisible="False">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
					<Border Width="34" Height="34" CornerRadius="17">
						<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="•" FontWeight="SemiBold"/>
					</Border>
					<StackPanel Grid.Column="1" Spacing="4">
						<TextBlock x:Name="DragPreviewNickname" FontWeight="SemiBold"/>
						<TextBlock x:Name="DragPreviewPath" Classes="muted"/>
					</StackPanel>
					<TextBlock x:Name="DragPreviewDefault" Grid.Column="2" VerticalAlignment="Center" Text="STANDARD" IsVisible="False" FontSize="10" FontWeight="SemiBold"/>
				</Grid>
			</Border>
		</Canvas>
		</Grid>
	</Grid>
	</Border>
</Window>
