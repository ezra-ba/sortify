<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sortify.App.ViewModels"
             x:Class="Sortify.App.Views.RuleEditorView"
             x:DataType="vm:RuleEditorViewModel">
  <UserControl.Styles>
    <Style Selector="Button.secondary.selected">
      <Setter Property="Background" Value="{DynamicResource BrushSurfaceSubtle}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style Selector="Border.rule-card">
      <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
    </Style>
    <Style Selector="Border.rule-item">
      <Setter Property="Background" Value="{DynamicResource BrushControlSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusButton}"/>
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="16">
    <TextBlock Classes="muted" Text="Lege fest, welche Dateien zu welchem Target-Ordner passen. Eine Regel verschiebt selbst keine Datei." TextWrapping="Wrap"/>
    <Border Classes="rule-card" Padding="20">
      <StackPanel Spacing="10" IsEnabled="{Binding !IsSaving}">
        <TextBlock Classes="heading" Text="Neue Sortierregel" FontSize="18"/>
        <TextBlock Classes="field-label" Text="Regelname"/>
        <TextBox Classes="motion" x:Name="RuleNameInput" Text="{Binding RuleName, Mode=TwoWay}" PlaceholderText="Zum Beispiel: Rechnungen"/>
        <TextBlock Classes="field-label" Text="Target-Ordner"/>
        <ComboBox x:Name="RuleTargetInput" ItemsSource="{Binding TargetFolders}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="Ziel auswählen">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:TargetFolderViewModel"><TextBlock Text="{Binding Nickname}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Classes="field-label" Text="Dateiname ohne Endung"/>
        <CheckBox Content="Erweitert: regulären Ausdruck verwenden" IsChecked="{Binding IsAdvancedMode, Mode=TwoWay}"/>
        <StackPanel IsVisible="{Binding !IsAdvancedMode}" Spacing="10">
          <TextBlock Classes="muted" Text="Alle Bedingungen müssen passen. Suchtext wird wörtlich geprüft; Groß-/Kleinschreibung wird ignoriert." TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding NameConditions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FileNameConditionViewModel">
                <StackPanel Spacing="8" Margin="0,0,0,10">
                  <WrapPanel>
                    <Button Classes="secondary motion" Classes.selected="{Binding IsContains}" Content="Enthält" Command="{Binding ContainsCommand}" Margin="0,0,6,6"/>
                    <Button Classes="secondary motion" Classes.selected="{Binding IsStartsWith}" Content="Beginnt mit" Command="{Binding StartsWithCommand}" Margin="0,0,6,6"/>
                    <Button Classes="secondary motion" Classes.selected="{Binding IsEndsWith}" Content="Endet mit" Command="{Binding EndsWithCommand}" Margin="0,0,6,6"/>
                    <Button Classes="secondary motion" Classes.selected="{Binding IsAnyName}" Content="Beliebiger Name" Command="{Binding AnyNameCommand}" Margin="0,0,6,6"/>
                  </WrapPanel>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Classes="motion" Text="{Binding Text, Mode=TwoWay}" IsVisible="{Binding NeedsText}" PlaceholderText="Suchtext eingeben"/>
                    <Button Grid.Column="1" Classes="secondary motion" Content="Entfernen" Command="{Binding RemoveCommand}"/>
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="secondary motion" Content="Weitere Bedingung" Command="{Binding AddConditionCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsAdvancedMode}" Spacing="8">
          <TextBox Classes="motion" x:Name="RulePatternInput" Text="{Binding FileNamePattern, Mode=TwoWay}" PlaceholderText="^rechnung"/>
          <TextBlock Classes="muted" Text="Bestehende Regex-Regeln bleiben erhalten. Beispiel: ^rechnung = beginnt mit rechnung; .* = beliebiger Name." TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Classes="field-label" Text="Erlaubte Dateiendungen"/>
        <TextBox Classes="motion" x:Name="RuleExtensionsInput" Text="{Binding Extensions, Mode=TwoWay}" PlaceholderText=".pdf, .docx"/>
        <TextBlock Classes="field-label" Text="Dateinamen-Vorgabe (optional)"/>
        <TextBox Classes="motion" x:Name="RuleRenameInput" Text="{Binding RenamePattern, Mode=TwoWay}" PlaceholderText="Originalname behalten"/>
        <TextBlock Classes="muted" Text="Leer = Originalname. Beispiel: Rechnung_{name}{ext}. Bei eigener Vorgabe muss {ext} genau einmal am Ende stehen." TextWrapping="Wrap"/>
        <Button Classes="primary motion" x:Name="CreateRuleButton" Content="Regel anlegen" Command="{Binding CreateRuleCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>
    <TextBlock x:Name="RuleResultMessage" Text="{Binding Message}" Foreground="{Binding MessageColor}" TextWrapping="Wrap"/>
    <TextBlock Classes="heading" Text="Gespeicherte Regeln" FontSize="18"/>
    <ItemsControl ItemsSource="{Binding ExistingRules}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:RuleListItem">
          <Border Classes="rule-item" Padding="12" Margin="0,0,0,8">
            <StackPanel Spacing="4"><TextBlock Classes="heading" Text="{Binding Label}" TextWrapping="Wrap"/><TextBlock Classes="muted" Text="{Binding Conditions}" TextWrapping="Wrap"/></StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Expander Header="Ziel einer vorhandenen Regel zuordnen" HorizontalAlignment="Stretch" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCard}" Padding="14">
      <StackPanel Spacing="10" IsEnabled="{Binding !IsSaving}">
        <TextBlock Classes="muted" Text="Hier kannst du insbesondere Altregeln ohne Target-ID reparieren. Andere Regelfelder bleiben erhalten." TextWrapping="Wrap"/>
        <ComboBox ItemsSource="{Binding ExistingRules}" SelectedItem="{Binding SelectedExistingRule, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="Regel auswählen">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:RuleListItem"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox ItemsSource="{Binding TargetFolders}" SelectedItem="{Binding RepairTarget, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="Target-Ordner auswählen">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:TargetFolderViewModel"><TextBlock Text="{Binding Nickname}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="secondary motion" Content="Zielzuordnung speichern" Command="{Binding AssignTargetCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
