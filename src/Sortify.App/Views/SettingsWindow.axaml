<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:platform="using:Avalonia.Controls" xmlns:views="using:Sortify.App.Views" xmlns:vm="using:Sortify.App.ViewModels" x:Class="Sortify.App.Views.SettingsWindow" Title="" Width="900" Height="560" MinWidth="760" MinHeight="460" WindowStartupLocation="CenterOwner" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="40">
  <Window.Styles>
    <Style Selector="Button.nav-item">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="8,1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Button.nav-item.selected">
      <Setter Property="Background" Value="{DynamicResource BrushSurfaceSubtle}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
    </Style>
    <Style Selector="Button.nav-item:pointerover:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource BrushSelectedHover}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
    </Style>
    <Style Selector="Button.nav-item.selected:pointerover:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource BrushSelectedHover}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentHover}"/>
    </Style>
    <Style Selector="Button.nav-item:pressed:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource BrushSelectedHover}"/>
    </Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="ToggleButton.animated-toggle">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="24"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource BrushBorder}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18"/>
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" ClipToBounds="True">
            <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
              <Ellipse x:Name="TestToggleKnob" Width="18" Height="18" Canvas.Left="2" Canvas.Top="3" Fill="#FFFFFF">
                <Ellipse.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Canvas.Left" Duration="0:0:0.26" Easing="CubicEaseOut"/>
                  </Transitions>
                </Ellipse.Transitions>
              </Ellipse>
            </Canvas>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.animated-toggle:checked"><Setter Property="Background" Value="{DynamicResource BrushAccent}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/></Style>
    <Style Selector="ToggleButton.animated-toggle:checked /template/ Ellipse#TestToggleKnob"><Setter Property="Canvas.Left" Value="26"/></Style>
    <Style Selector="ToggleButton.animated-toggle:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}"/><Setter Property="BorderThickness" Value="2"/></Style>
  </Window.Styles>
  <Border BorderThickness="0,1,0,0">
  <Grid RowDefinitions="40,*">
    <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,0,170,0" platform:Win32Properties.NonClientHitTestResult="Caption">
      <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" IsHitTestVisible="False">
        <Image Width="24" Height="24" Stretch="Uniform" Source="/Assets/Branding/sortify-icon.png"/>
        <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="Sortify · Einstellungen"/>
      </StackPanel>
    </Border>
  <Grid Grid.Row="1" ColumnDefinitions="260,*">
    <Border x:Name="NavigationSurface" Grid.Column="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0" Padding="14,18,10,18">
      <Grid RowDefinitions="*">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="3">
            <TextBlock x:Name="GeneralHeader" Text="ALLGEMEIN" FontSize="11" FontWeight="SemiBold" Margin="10,4,0,7"/>
            <Button x:Name="GeneralButton" Classes="nav-item selected" Click="SelectSection" Tag="Allgemein" Content="⚙   Allgemein"/>
            <Button x:Name="WatchedButton" Classes="nav-item" Click="SelectSection" Tag="Überwachungsordner" Content="◉   Überwachungsordner"/>
            <TextBlock x:Name="SortingHeader" Text="SORTIERUNG" FontSize="11" FontWeight="SemiBold" Margin="10,18,0,7"/>
            <Button x:Name="RulesButton" Classes="nav-item" Click="SelectSection" Tag="Sortierregeln" Content="≡   Sortierregeln"/>
            <TextBlock x:Name="AppearanceHeader" Text="DARSTELLUNG" FontSize="11" FontWeight="SemiBold" Margin="10,18,0,7"/>
            <Button x:Name="AppearanceButton" Classes="nav-item" Click="SelectSection" Tag="Darstellung" Content="◐   Darstellung"/>
            <TextBlock Text="DIAGNOSE" FontSize="11" FontWeight="SemiBold" Margin="10,18,0,7"/>
            <Button x:Name="ActivityLogButton" Classes="nav-item" Click="SelectSection" Tag="Aktivitätsprotokoll" Content="≡   Aktivitätsprotokoll"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
    <Grid x:Name="ContentSurface" Grid.Column="1" Background="{DynamicResource BrushCanvas}" RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="38,28,38,18">
        <TextBlock x:Name="SectionTitle" FontSize="26" FontWeight="SemiBold" Text="Allgemein" VerticalAlignment="Center"/>
        <Grid x:Name="RuleActions" Grid.Column="1" IsVisible="False">
          <Button x:Name="NewRuleButton" Classes="secondary motion" Width="40" Height="40" Padding="10" CornerRadius="12"
                  DataContext="{Binding #RulesEditor.DataContext}" x:DataType="vm:RuleEditorViewModel"
                  Command="{Binding BeginCreateCommand}" IsVisible="{Binding IsOverview}"
                  IsEnabled="{Binding !IsSaving}" ToolTip.Tip="Neue Regel erstellen" AutomationProperties.Name="Neue Regel erstellen">
            <Path Data="M 12,2 L 12,22 M 2,12 L 22,12" Width="16" Height="16" Stretch="Uniform"
                  Stroke="{DynamicResource BrushText}" StrokeThickness="1.75"/>
          </Button>
        </Grid>
      </Grid>
    <ScrollViewer x:Name="SettingsContentScroll" Grid.Row="1" Padding="38,0,38,32">
      <StackPanel Spacing="12">
        <StackPanel x:Name="GeneralSettingsPanel" Spacing="10" Margin="0,18,0,0" IsVisible="True">
          <Border Padding="14,12" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Sortify automatisch starten, wenn dein Computer startet" TextWrapping="Wrap"/>
              <ToggleButton x:Name="AutoStartToggle" Classes="animated-toggle" Grid.Column="1" VerticalAlignment="Center" IsChecked="False" IsCheckedChanged="GeneralSettingChanged"/>
            </Grid>
          </Border>
          <Border x:Name="StartMinimizedCard" Padding="14,12" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3" Margin="0,0,16,0">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Sortify minimiert starten" TextWrapping="Wrap"/>
                <TextBlock Classes="muted" Text="Sortify im Hintergrund starten, damit es dich nicht gleich erschlägt" TextWrapping="Wrap"/>
              </StackPanel>
              <ToggleButton x:Name="StartMinimizedToggle" Classes="animated-toggle" Grid.Column="1" VerticalAlignment="Center" IsChecked="False" IsCheckedChanged="GeneralSettingChanged"/>
            </Grid>
          </Border>
          <Border Padding="14,12" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3" Margin="0,0,16,0">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Sortify in den Infobereich minimieren" TextWrapping="Wrap"/>
                <TextBlock Classes="muted" Text="Durch Klicken auf X wird Sortify minimiert, statt es vollständig zu schließen" TextWrapping="Wrap"/>
              </StackPanel>
              <ToggleButton x:Name="CloseToTrayToggle" Classes="animated-toggle" Grid.Column="1" VerticalAlignment="Center" IsChecked="True" IsCheckedChanged="GeneralSettingChanged"/>
            </Grid>
          </Border>
          <Border Padding="14,12" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3" Margin="0,0,16,0">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Test-Toggle" TextWrapping="Wrap"/>
                <TextBlock Classes="muted" Text="Dieser Schalter dient nur zu Testzwecken" TextWrapping="Wrap"/>
              </StackPanel>
              <ToggleButton x:Name="TestToggle" Classes="animated-toggle" Grid.Column="1" VerticalAlignment="Center" IsChecked="False"/>
            </Grid>
          </Border>
        </StackPanel>
        <views:RuleEditorView x:Name="RulesEditor" IsVisible="False"/>
        <Border x:Name="AppearanceCard" IsVisible="False" Margin="0,18,0,0" Padding="12,10" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="AppearanceTitle" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Darkmode"/>
            <ToggleButton x:Name="DarkModeToggle" Classes="animated-toggle" Grid.Column="1" VerticalAlignment="Center" IsChecked="False" IsCheckedChanged="DarkModeChanged"/>
          </Grid>
        </Border>
        <StackPanel x:Name="ActivityLogPanel" x:DataType="vm:ActivityLogViewModel" IsVisible="False" Spacing="10" Margin="0,18,0,0">
          <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
            <Button Content="Aktualisieren" Command="{Binding LoadCommand}" Padding="14,7"/>
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding StatusMessage}" Classes="muted"/>
          </Grid>
          <TextBlock Text="{Binding ReadError}" Foreground="#B42318" IsVisible="{Binding HasReadError}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SkippedEntries, StringFormat='{} {0} beschädigte Einträge wurden übersprungen.'}" Foreground="#B45309" IsVisible="{Binding HasSkippedEntries}"/>
          <TextBlock Text="Aktivitätsprotokoll wird geladen …" IsVisible="{Binding IsLoading}" Classes="muted"/>
          <TextBlock Text="Noch keine Aktivitäten protokolliert." IsVisible="{Binding HasNoEntries}" Classes="muted"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasEntries}">
            <ItemsControl ItemsSource="{Binding Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityLogItem">
                  <Border Padding="10,8" Margin="0,0,0,6" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Message}" FontSize="14"/>
                      <TextBlock Text="{Binding EventName}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding TimestampUtc, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding Level}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    </Grid>
  </Grid>
  </Grid>
  </Border>
</Window>
